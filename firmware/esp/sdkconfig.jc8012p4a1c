# JC8012P4A1C (ESP32-P4 10.1") — tiny386, ESP-IDF v5.4.x defaults.
# Partial config: idf.py fills in the rest on first configure.
CONFIG_IDF_TARGET="esp32p4"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Tried shrinking the L2 cache to buy internal SRAM for cpu_exec1(): the P4
# splits one 768 KB L2MEM between cache and RAM, so in principle 256 KB of
# cache frees 512 KB of SRAM.  It does not help here — the IRAM segment the
# linker can place code into does not grow with it, and the link fails at
# both 256 KB and 128 KB.  Keep the largest cache instead; the interpreter
# runs from flash through it.
CONFIG_CACHE_L2_CACHE_512KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# B82 (lead 21 Nov, Doom quit -> Windows <= 2.5 s): the 115200-baud console blocks on boot logs (~0.25 s bootloader, ~0.2 s app)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# the bootloader image verify stays ON in every build (lead + B83, 21 Nov: safety over ~0.3 s)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# USB HID host (keyboard + mouse)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# FatFs long filenames for SD disk images
CONFIG_FATFS_LFN_HEAP=y

# The emulator seeks to a random offset in a 512 MB file before every
# single disk read.  Without fast seek, FatFs answers each of those by
# walking the cluster chain from the start of the file — measured at
# ~9.6 ms per 512-byte sector, which had Windows spending 97% of its
# wall clock waiting on the disk.  Fast seek builds a cluster link map
# once at open, so a seek costs a lookup instead of a walk.  The image
# is preallocated and never grows, which is the case fast seek requires.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=256

# ── IRAM budget: make room for the emulator's interpreter loop ──────────
# cpu_exec1() is the hottest code in the system; running it from internal
# RAM instead of cached flash is the single biggest emulator speed-up.
# It needs ~140 KB of IRAM, so push everything that does not have to be in
# IRAM back out to flash.  (Safe here: nothing writes flash at runtime —
# storage is the SD card — so ISRs never run during a flash operation.)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_PANIC_HANDLER_IRAM=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_ESP_DEBUG_OCDAWARE=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_ESP_INT_WDT=n
CONFIG_VFS_SUPPORT_TERMIOS=n
CONFIG_VFS_SUPPORT_SELECT=n
CONFIG_ESP_DEBUG_STUBS_ENABLE=n
CONFIG_ESP_GDBSTUB_ENABLED=n
# CONFIG_SPIRAM_MEMTEST is not set

# MEM team 16 Nov (study/SRAM_MAP.md section 3): cold internal-RAM users out. Each line: why it exists / why safe.
# bss of cold objects (B45 latency bench buffers, vendor touch filter) lives in PSRAM (EXT_RAM_BSS_ATTR + teams linker.lf)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# ringbuf = UART/USB-serial console queues; none is used from an IRAM ISR (no UART_ISR_IN_IRAM) and we never run them with the cache off
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# light-sleep-only workarounds: this machine never light-sleeps
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
# CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND is not set
# CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND is not set
