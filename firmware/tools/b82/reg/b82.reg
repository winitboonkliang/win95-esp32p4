REGEDIT4

[HKEY_CLASSES_ROOT\.dm1]
@="b82dm1"

[HKEY_CLASSES_ROOT\b82dm1]
@="Doom"

[HKEY_CLASSES_ROOT\b82dm1\DefaultIcon]
@="C:\\WINDOWS\\DOOM1.ICO"

[HKEY_CLASSES_ROOT\b82dm1\shell\open\command]
@="C:\\WINDOWS\\B76APP.EXE"

[HKEY_CLASSES_ROOT\b82dm1\shell\open\ddeexec]
@="[open(\"%1\")]"

[HKEY_CLASSES_ROOT\b82dm1\shell\open\ddeexec\application]
@="B76Pad"

[HKEY_CLASSES_ROOT\b82dm1\shell\open\ddeexec\topic]
@="System"

